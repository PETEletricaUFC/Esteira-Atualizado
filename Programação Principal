//------------  BIBLIOTECAS  ------------// 
  #include <Wire.h>
  #include <Adafruit_GFX.h>
  #include <Adafruit_SSD1306.h>
//---------------------------------------//

//------------  VARIÁVEIS  ------------//
  int quantidade = 0; // Contador de peças
  int azul = 0; // Leitura do Azul 
  int vermelho = 0; // Leitura do Vermelho
  int verde = 0; // Leitura do Verde
//---------------------------------------//

//------------  PINOUTS  ------------//
#define sensorpin 7
#define S0 5
#define S1 6
#define S2 8
#define S3 9
#define OUT 10
#define Motor 11
//---------------------------------------//

// Definições de tamanho para o GME12864-11
#define LARGURA_TELA 128 
#define ALTURA_TELA 64   

Adafruit_SSD1306 display(LARGURA_TELA, ALTURA_TELA, &Wire, -1);

void setup() 
{
  // CONFIGURAÇÕES DO DISPLAY
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) // O GME12864-11 costuma responder no endereço 0x3C 
  { 
    for(;;);
  }
  display.clearDisplay(); // Limpa a tela
  display.setTextSize(1); // Tamanho do texto (1 a 8)
  display.setTextColor(SSD1306_WHITE); // Cor do texto

  // CONFIGURAÇÕES DOS PINOS
  pinMode(sensorpin, INPUT);  // Configura o pino do sensor como entrada
  pinMode(S0, OUTPUT); // Configura o pino do S0 como saída
  pinMode(S1, OUTPUT); // Configura o pino do S1 como saída
  pinMode(S2, OUTPUT); // Configura o pino do S2 como saída
  pinMode(S3, OUTPUT); // Configura o pino do S3 como saída
  pinMode(OUT, INPUT); // Configura o pino do OUT como entrada
  pinMode(Motor, OUTPUT); // Configura o pino de PWM do motor como saída

  digitalWrite(S0, HIGH);
  digitalWrite(S1, LOW);

  analogWrite(Motor, 100);
}

void loop() 
{
  
  if (digitalRead(sensorpin) == LOW) // LOW pois o sensor é lógica de inversa
  {
    quantidade++;
    cor ();
  }

  display.setCursor (32,10); // Coloca o cursor no meio da tela
  display.print("Quantidade: "); // Printa no display "Quantidade"
  display.print(quantidade); // Printa no display a quantiade
  display.setCursor (32, 20);
  display.print("Cor: ");
  display.display();

  delay(1000); // Tempo de confirmação entre as leituras (alterar)

  display.clearDisplay(); // Limpa a Tela
}

void cor() // Função para verificar a cor
{
  identificar();
  display.setCursor (32,20); // Coloca o cursor no meio da tela
  display.print("Cor "); // Printa no display "Quantidade"

  //Verifica se a cor vermelha foi detectada
  if (vermelho < 15 && azul > 10 && verde > 10)
  {
    display.print("Vermelho");
  }

  //Verifica se a cor azul foi detectada
  else if (verde > 10 && vermelho > 10 && azul < 15)
  {
    display.print("Azul");
  }

  //Verifica se a cor verde foi detectada
  else if (verde < 15 && azul > 10 && vermelho > 10)
  {
    display.print("Verde");
  }

  //Verifica se a cor verde foi detectada
  else if (verde < 13 && azul < 13 && vermelho < 13)
  {
    display.print("Amarelo");
  }
  display.display();
}

void identificar() // Rotinas de ler os sensores
{
  digitalWrite(S2, LOW);
  digitalWrite(S3, LOW);
  vermelho = pulseIn(OUT, digitalRead(OUT) == HIGH ? LOW : HIGH);
  digitalWrite(S3, HIGH);
  azul = pulseIn(OUT, digitalRead(OUT) == HIGH ? LOW : HIGH);
  digitalWrite(S2, HIGH);
  verde = pulseIn(OUT, digitalRead(OUT) == HIGH ? LOW : HIGH);
}
